[sub_resource type="Shader" id="Shader_s04oc"]
code = "// 玩家角色的闪白效果（供 AnimationPlayer 驱动）。
//
// 为什么用 shader 而不是 modulate：
//   modulate 是整体乘一个颜色，暗色像素会变灰，达不到「被打亮」的纯白效果。
//   本 shader 把每个像素朝纯白插值，flash_amount = 1.0 时完全变白。
//
// AnimationPlayer 的轨道路径写法（已实测）：
//   Visuals:material:shader_parameter/flash_amount
//   注意必须写 material 而不是 material_override；后者不是 CanvasItem 的基类属性，会解析失败。
shader_type canvas_item;

// 闪白强度。0 = 原图，1 = 全白。
uniform float flash_amount : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	tex.rgb = mix(tex.rgb, vec3(1.0), flash_amount);
	COLOR = tex;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_78iq1"]
shader = SubResource("Shader_s04oc")
shader_parameter/flash_amount = 0.0

