# Godot 4+ specific ignores
.godot/
/android/
.idea/
# Godot 重写 CUSGA.csproj 前留下的备份（机器生成的副本，每次重写都会轮换出一个新的）
CUSGA.csproj.old*
addons/*
!addons/skill_targeting_type_codegen/
!addons/skill_targeting_type_codegen/**
!addons/card_csv_sync/
!addons/card_csv_sync/**
node_modules/
card_table/.sync_state.json
card_table/.card_csv_sync_result.json
card_table/card_tables.xlsx
card_table/card_tables.pending.xlsx
card_table/~$*.xlsx
card_table/__pycache__/
card_table/.sync_backups/
tests/CUSGA.Tests/bin/Debug/net8.0/
tests/CUSGA.Tests/obj/
