<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <Target Name="InstallHusky" BeforeTargets="Restore;BeforeBuild" Condition="'$(CI)' != 'true'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="Low" />
    <Exec Command="dotnet tool run husky install" StandardOutputImportance="Low" />
  </Target>
</Project>
